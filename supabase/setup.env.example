# Copie este arquivo para supabase/setup.env e preencha com os dados do SEU projeto.
# supabase/setup.env nunca deve ser commitado (ja esta no .gitignore).

# Account -> Access Tokens (supabase.com/dashboard/account/tokens)
SUPABASE_ACCESS_TOKEN=

# Project Settings -> General -> Reference ID
SUPABASE_PROJECT_REF=

# Secrets usados pelas Edge Functions (alem de SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY,
# que o proprio Supabase injeta sozinho em toda funcao)
CHATWOOT_BASE_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_PLATFORM_TOKEN=
CHATWOOT_AGENCY_USER_ID=
N8N_SDR_WEBHOOK_URL=
N8N_CLEAR_MEMORY_URL=
N8N_CLEAR_MEMORY_SECRET=
OPENAI_API_KEY=
